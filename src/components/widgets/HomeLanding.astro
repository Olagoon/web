---
/* eslint-disable @typescript-eslint/no-explicit-any */
import { getProducts } from '~/utils/products';
import { localizeHref, withTrailingSlash } from '~/i18n/routing';
import WarrantyStrip from '~/components/widgets/WarrantyStrip.astro';
import Icon from '~/components/ui/Icon.astro';
import cfg from '~/config.yaml';

interface Props {
  lang?: string;
  localize?: boolean;
  page: Record<string, any>;
}

const { lang = 'en', localize = false, page } = Astro.props;

const lh = (href?: string): string => {
  if (!href) return '#';
  if (!href.startsWith('/') || href.startsWith('//')) return href;
  return localize ? localizeHref(href, lang) : withTrailingSlash(href);
};

const branding = (cfg as any)?.branding || {};

const allProducts = await getProducts();
const pools = ['compact-plunge', 'family-oasis', 'grand-lagoon']
  .map((id) => allProducts.find((p) => p.id === id))
  .filter((p) => Boolean(p));
const accessories = ['sand-filter-pump', 'thermal-cover', 'ground-mat', 'entry-steps']
  .map((id) => allProducts.find((p) => p.id === id))
  .filter((p) => Boolean(p));

const specOf = (p: any, label: string): string =>
  (p.specs || []).find((s: any) => s.label === label)?.value || '';

const faqItems: Array<{ q: string; a: string }> = (page.faqs?.items || []) as Array<{ q: string; a: string }>;

const heroImage = page.hero?.image?.src || '/images/olagoon/hero/pool-lagoon-hero.webp';
---

<!-- AI Semantic Blocks (hidden, for AI crawler consumption) -->
<section class="sr-only" data-ai-block="entity" aria-hidden="true">
  <p>
    OLagoon is a backyard pool brand building drop-stitch inflatable pools in three sizes, from a 2 m
    plunge pool to a 5 m party lagoon, plus sand filtration, thermal covers, ground mats, and entry
    steps.
  </p>
</section>
<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    OLagoon pools are high-pressure drop-stitch inflatable swimming pools with 20 cm rigid sit-on
    walls, inflated to 10–15 PSI — the same construction class as inflatable yacht tenders — with
    integrated plumbing ports for sand filtration.
  </p>
</section>
<section class="sr-only" data-ai-block="use-case" aria-hidden="true">
  <p>
    OLagoon pools are used for family backyard swimming, cold-plunge recovery, kids' summer play,
    pool parties, and seasonal pools for patios, decks, rentals, and glamping sites.
  </p>
</section>
<section class="sr-only" data-ai-block="comparison" aria-hidden="true">
  <p>
    Compared to in-ground pools, OLagoon installs in an afternoon without digging or permits.
    Compared to ring pools, its drop-stitch walls hold pressure all season without bulging and are
    rigid enough to sit on.
  </p>
</section>
<section class="sr-only" data-ai-block="constraint" aria-hidden="true">
  <p>
    OLagoon pools require firm, level ground, adult supervision during use, and full removal of the
    thermal cover before swimming. They are seasonal pools stored indoors over winter.
  </p>
</section>
<section class="sr-only" data-ai-block="process" aria-hidden="true">
  <p>
    Each pool is built on a high-density drop-stitch core with reinforced seams, pressure-tested,
    and inspected before packing. Setup is unroll, inflate with the electric pump, connect the
    sand filter, and fill.
  </p>
</section>

<!-- 01 Hero -->
<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-secondary">
  <div class="absolute inset-0">
    <img
      src={heroImage}
      alt={page.hero?.image?.alt || 'OLagoon drop-stitch inflatable pool'}
      class="w-full h-full object-cover opacity-65"
      style="object-position: center 40%;"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary/55 via-secondary/35 to-secondary/15"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full py-24">
    <div class="max-w-4xl">
      <div class="reveal">
        <span
          class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-white/50 mb-6"
        >
          <span class="w-8 h-px bg-primary"></span>
          {page.hero?.tagline || 'Drop-Stitch Inflatable Pools'}
        </span>
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.05] text-balance text-white"
        >
          {page.hero?.title || 'Your Backyard Lagoon, Engineered Like a Yacht.'}
        </h1>
        <p class="mt-5 text-2xl md:text-3xl font-bold tracking-tight text-white/90">
          {page.hero?.slogan || 'Rigid at 15 PSI. Ready in an afternoon.'}
        </p>
        <p class="mt-6 text-lg md:text-xl text-white/70 max-w-3xl text-pretty leading-relaxed">
          {page.hero?.subtitle || ''}
        </p>
        <div class="mt-10 flex items-center gap-4 flex-wrap">
          {
            (page.hero?.actions || []).map((act: any) =>
              act.variant === 'primary' ? (
                <a
                  href={lh(act.href || '/products/')}
                  class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#006a78] text-white font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all hover:-translate-y-0.5"
                >
                  {act.text || 'Explore the Pools'}
                  <span class="text-lg">→</span>
                </a>
              ) : (
                <a
                  href={lh(act.href || '/size-guide/')}
                  class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white/80 font-medium rounded-full hover:bg-white/10 hover:text-white transition-all backdrop-blur-sm"
                >
                  {act.text || 'Find Your Size'}
                </a>
              )
            )
          }
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-white/60">
          {
            (page.hero?.bullets || []).map((bullet: string) => (
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                {bullet}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<WarrantyStrip />

<!-- 02 Pool Collection -->
<section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase"
      >{page.collection?.tagline || 'The Pool Collection'}</span
    >
    <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary"
      >{page.collection?.title || 'Three Lagoons. Pick Your Size.'}</h2
    >
    <p class="mt-4 text-lg text-gray-500">{page.collection?.subtitle || ''}</p>
  </div>
  <div class="grid md:grid-cols-3 gap-8">
    {
      pools.map((p) => (
        <a
          href={lh(p.permalink)}
          class="group bg-white border border-gray-200 rounded-3xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
        >
          <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex flex-wrap gap-2 mb-3">
              {specOf(p, 'Length') && (
                <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full">
                  {specOf(p, 'Length')}
                </span>
              )}
              {specOf(p, 'Width') && (
                <span class="px-3 py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">
                  {specOf(p, 'Width')}
                </span>
              )}
            </div>
            <h3 class="text-xl font-bold text-secondary">{p.title}</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed flex-1">{p.summary}</p>
            <div class="mt-4 flex items-center justify-between">
              {p.price?.amount && (
                <span class="text-lg font-bold text-secondary"
                  >${p.price.amount}
                  {p.price.note && <span class="text-xs font-normal text-gray-400 block">{p.price.note}</span>}
                </span>
              )}
              <span
                class="inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:gap-2 transition-all"
              >
                View <span>→</span>
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
  <div class="text-center mt-12">
    <a
      href={lh(page.collection?.cta?.href || '/products/compare/')}
      class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-300 text-gray-700 font-semibold rounded-full hover:border-primary hover:text-primary transition-all"
    >
      {page.collection?.cta?.text || 'Compare All Models'} <span>→</span>
    </a>
  </div>
</section>

<!-- 03 Who We Serve -->
{
  page.who_we_serve?.items?.length ? (
    <section class="py-16 md:py-24 px-6 bg-[#F8FAFB]">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-4">
            <span class="w-8 h-px bg-primary" />
            {page.who_we_serve?.tagline || 'Which Lagoon Fits?'}
          </span>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-balance text-secondary">
            {page.who_we_serve?.title || 'Find the Pool That Fits Your Backyard'}
          </h2>
          <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">{page.who_we_serve?.subtitle || ''}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {page.who_we_serve.items.map((item: any) => (
            <a
              href={lh(item.link)}
              class="group relative bg-white rounded-3xl p-8 border border-gray-200 hover:border-primary/30 hover:shadow-xl transition-all duration-500 hover:-translate-y-1 flex flex-col"
            >
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 text-primary">
                <Icon name={item.icon || 'tabler:ripple'} class="w-7 h-7" />
              </div>
              <h3 class="text-xl font-bold text-secondary mb-3">{item.title || ''}</h3>
              <p class="text-sm text-gray-500 leading-relaxed flex-1">{item.description || ''}</p>
              <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:gap-2 transition-all">
                {item.cta || 'Learn More'} →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<!-- 04 Engineering -->
{
  page.business_solutions?.items?.length ? (
    <section class="relative py-16 md:py-24 px-6 bg-white overflow-hidden">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-4">
            <span class="w-8 h-px bg-primary" />
            {page.business_solutions?.tagline || 'Engineered Like a Yacht'}
          </span>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-secondary">
            {page.business_solutions?.title || 'Yacht-Grade Construction, Backyard-Sized'}
          </h2>
          <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">{page.business_solutions?.subtitle || ''}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 reveal">
          {page.business_solutions.items.map((item: any) => (
            <div class="bg-[#F8FAFB] rounded-3xl p-8 group hover:shadow-lg transition-all duration-500 hover:-translate-y-1">
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-6 text-primary">
                <Icon name={item.icon || 'tabler:shield-check'} class="w-7 h-7" />
              </div>
              <h3 class="text-lg font-bold text-secondary">{item.title || ''}</h3>
              <p class="mt-3 text-sm text-gray-500 leading-relaxed">{item.description || ''}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<!-- 05 Accessories -->
{
  accessories.length ? (
    <section class="py-16 md:py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase"
            >{page.accessories?.tagline || 'Pool Essentials'}</span
          >
          <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary"
            >{page.accessories?.title || 'Everything Your Lagoon Needs'}</h2
          >
          <p class="mt-4 text-lg text-gray-500">{page.accessories?.subtitle || ''}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {accessories.map((p) => (
            <a
              href={lh(p.permalink)}
              class="group bg-white border border-gray-200 rounded-3xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
            >
              <div class="aspect-square bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
                <img
                  src={p.image}
                  alt={p.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-5 flex flex-col flex-1">
                <h3 class="font-bold text-secondary">{p.title}</h3>
                <p class="mt-2 text-sm text-gray-500 leading-relaxed flex-1">{p.summary}</p>
                {p.price?.amount && (
                  <span class="mt-3 text-base font-bold text-secondary">${p.price.amount}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<!-- 06 Proof Points -->
<section class="relative py-16 md:py-24 px-6 bg-secondary overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-64 h-64 rounded-full bg-white blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-primary blur-3xl"></div>
  </div>
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white">
        {page.proof_points?.title || 'Numbers That Hold Water'}
      </h2>
      <p class="mt-4 text-lg text-white/60 max-w-2xl mx-auto">{page.proof_points?.subtitle || ''}</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 reveal">
      {
        (page.proof_points?.items || []).map((pt: any) => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-primary">{pt.metric || ''}</div>
            <p class="mt-2 text-sm text-white/50 uppercase tracking-wider">{pt.label || ''}</p>
            <p class="mt-1 text-xs text-white/30">{pt.detail || ''}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 07 FAQ -->
{
  faqItems.length ? (
    <section class="bg-gray-50 py-16 md:py-24 px-6" id="faq" data-ai-block="faq">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-sm font-medium text-primary tracking-wide uppercase">FAQ</span>
          <h2 class="mt-4 text-4xl font-semibold text-gray-900">{page.faqs?.title || 'Backyard Pool FAQs'}</h2>
          <p class="mt-4 text-lg text-gray-500">{page.faqs?.subtitle || ''}</p>
        </div>
        <div class="space-y-4" data-faq-list>
          {faqItems.map((item) => (
            <details
              data-faq-item
              class="bg-white border border-gray-200 rounded-xl overflow-hidden group"
            >
              <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
                <span>{item.q}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="px-6 pb-4">
                <p class="text-gray-600 leading-relaxed">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<!-- 08 Final CTA -->
{
  page.cta?.title ? (
    <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
      <div class="bg-primary/5 border border-primary/20 rounded-3xl px-8 py-16 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary text-balance">{page.cta?.title || ''}</h2>
        <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">{page.cta?.subtitle || ''}</p>
        <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
          {(page.cta?.actions || []).map((act: any) =>
            act.variant === 'primary' ? (
              <a
                href={lh(act.href || '/products/')}
                class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#006a78] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5"
              >
                {act.text || 'Shop the Pools'}
              </a>
            ) : (
              <a
                href={lh(act.href || '/contact/')}
                class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-300 text-gray-700 rounded-full font-medium hover:border-primary hover:text-primary transition-all"
              >
                {act.text || 'Contact Us'}
              </a>
            )
          )}
        </div>
      </div>
    </section>
  ) : null
}

<!-- 09 Contact -->
<section class="bg-gray-50 py-16 md:py-24 px-6" id="contact">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">Get in touch</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">Contact OLagoon</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden text-center">
        <div class="h-32 relative overflow-hidden bg-gray-200 flex items-center justify-center">
          <iframe
            src="https://www.google.com/maps?q=1209+Mountain+Road+NE,+Albuquerque,+NM+87110&output=embed"
            class="w-full h-full object-cover"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of OLagoon headquarters"></iframe>
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-gray-900">Address</h3>
          <p
            class="mt-2 text-gray-500 text-sm"
            set:html={branding.address || '1209 Mountain Road NE, Albuquerque, NM 87110, USA'}
          />
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden text-center">
        <div class="h-32 bg-primary/10 flex items-center justify-center">
          <Icon name="tabler:phone" class="w-10 h-10 text-primary" />
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-gray-900">Phone</h3>
          <p class="mt-2 text-gray-500 text-sm">{branding.phone || '+1 (279) 732-3333'}</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden text-center">
        <div class="h-32 bg-primary/10 flex items-center justify-center">
          <Icon name="tabler:mail" class="w-10 h-10 text-primary" />
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-gray-900">Email</h3>
          <p class="mt-2 text-gray-500 text-sm">{branding.email || 'info@olagoon.com'}</p>
        </div>
      </div>
    </div>
    <div class="text-center mt-12">
      <a
        href={lh('/contact/')}
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#006a78] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
      >
        Send us a message <span>→</span>
      </a>
    </div>
  </div>
</section>

<!-- JSON-LD -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Brand',
    name: 'OLagoon',
    url: 'https://olagoon.com',
    description:
      'OLagoon builds drop-stitch inflatable backyard pools with 20 cm rigid walls at 10–15 PSI, plus sand filtration, thermal covers, ground mats, and entry steps.',
    slogan: 'Your Backyard Lagoon, Engineered Like a Yacht.',
    knowsAbout: [
      'Drop-Stitch Inflatable Pools',
      'Backyard Inflatable Pools',
      'Plunge Pools',
      'Sand Filtration',
      'Pool Water Safety',
    ],
    product: allProducts.map((p) => ({
      '@type': 'Product',
      name: p.title,
      description: p.summary,
      url: 'https://olagoon.com' + p.permalink,
      category: p.category,
    })),
  })}
/>
{
  faqItems.length && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      })}
    />
  )
}

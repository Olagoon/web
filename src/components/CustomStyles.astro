---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght.css';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 130 148);
    --aw-color-secondary: rgb(24 36 48);
    --aw-color-accent: rgb(0 150 172);

    --aw-color-text-heading: rgb(24 36 48);
    --aw-color-text-default: rgb(47 58 68);
    --aw-color-text-muted: rgb(100 112 124 / 80%);
    --aw-color-bg-page: rgb(247 245 240);
    --aw-color-bg-page-dark: rgb(24 36 48);

    ::selection {
      background-color: rgb(0 130 148 / 20%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 148 168);
    --aw-color-secondary: rgb(0 130 148);
    --aw-color-accent: rgb(103 214 226);

    --aw-color-text-heading: rgb(247 245 240);
    --aw-color-text-default: rgb(222 226 230);
    --aw-color-text-muted: rgb(180 186 195 / 72%);
    --aw-color-bg-page: rgb(13 20 27);

    ::selection {
      background-color: rgb(0 148 168 / 30%);
    }
  }
</style>

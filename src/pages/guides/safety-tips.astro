---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Pool Safety Tips –${SITE.name}`,
  description:
    'Essential safety practices for backyard pool use: active supervision, barrier placement, drain and pump safety, electrical safety, and emergency readiness.',
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    article={{
      headline: 'Pool Safety Tips',
      description:
        'Essential safety practices for backyard pool use: active supervision, barrier placement, drain and pump safety, electrical safety, and emergency readiness.',
      datePublished: '2025-01-20',
    }}
    data={{ url: 'https://olagoon.com/guides/safety-tips' }}
  />
  <JsonLd
    type="HowTo"
    howto={{
      name: 'Pool Safety Tips',
      description: 'Essential safety practices for swimming pool use.',
      steps: [
        {
          name: 'Always Watch Swimmers',
          text: 'Always watch children in and around the pool. Designate a sober adult water watcher with no distractions.',
        },
        {
          name: 'Secure Barriers and Access',
          text: 'Use a fence or barrier where required. Remove or secure entry steps and ladders when the pool is not in use.',
        },
        {
          name: 'Check Water Depth and Clarity',
          text: 'Enforce no-diving rules in shallow pools. Keep the water clean and clear so the bottom is always visible.',
        },
        {
          name: 'Drain and Pump Safety',
          text: 'Keep loose clothing and long hair away from the sand-filter pump intake. Stop the pump before any maintenance.',
        },
        {
          name: 'Electrical Safety',
          text: 'Keep electrical devices and extension cords away from the pool. Connect the pump only to ground-fault protected outlets.',
        },
        {
          name: 'Emergency Readiness',
          text: 'Keep a first-aid kit, reaching pole, and phone nearby. Learn CPR and post emergency numbers poolside.',
        },
      ],
    }}
  />
  <section class="max-w-3xl mx-auto py-24 px-6" data-ai-block="definition">
    <a href="/guides" class="text-sm text-sky-600 hover:text-sky-700">← Guides</a>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">Pool Safety Tips</h1>
    <p class="mt-4 text-lg text-gray-500">Safety is not optional. Follow these guidelines every time you swim.</p>

    <div class="mt-12 space-y-12">
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">1. Always Watch Swimmers</h2>
        <p class="mt-3 text-gray-600">
          Always watch children in and around the pool. Designate a sober adult water watcher whose only task is
          supervising swimmers — no phones, no books, no distractions. Rotate the watcher every 20 minutes to stay
          alert.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">2. Secure Barriers and Access</h2>
        <p class="mt-3 text-gray-600">
          Use a fence or barrier where local regulations require one. Remove or secure entry steps and ladders when the
          pool is not in use. Store the pool deflated or covered during the off-season to prevent unsupervised access.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">3. Check Water Depth and Clarity</h2>
        <p class="mt-3 text-gray-600">
          OLagoon pools are 20 cm to 60 cm deep — no diving, ever. Keep the water clean and clear so the bottom is
          always visible. If you cannot see the pool floor, clean and filter the water before anyone swims.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">4. Drain and Pump Safety</h2>
        <p class="mt-3 text-gray-600">
          Keep loose clothing and long hair away from the sand-filter pump intake. Stop the pump and disconnect power
          before any maintenance. Follow the pump manual for safe operation and filtration schedules.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">5. Electrical Safety</h2>
        <p class="mt-3 text-gray-600">
          Keep electrical devices and extension cords away from the pool. Connect the sand-filter pump only to
          ground-fault protected outlets. Route cables so they never cross walkways or sit in standing water.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold text-gray-900">6. Emergency Readiness</h2>
        <p class="mt-3 text-gray-600">
          Keep a first-aid kit, a reaching pole, and a phone nearby. Learn CPR and post emergency numbers poolside.
          Empty small pools completely when not in use if young children may reach them.
        </p>
      </section>
    </div>

    <section class="mt-12 p-6 bg-sky-50 rounded-2xl border border-sky-100">
      <h2 class="font-semibold text-gray-900">Related</h2>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <a
          href="/guides/pool-safety-essentials"
          class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-sky-300"
          >Pool Safety Essentials</a
        >
        <a
          href="/guides/choosing-a-drop-stitch-pool"
          class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-sky-300"
          >Choosing a Drop-Stitch Pool</a
        >
        <a
          href="/safety"
          class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-sky-300"
          >Safety Standards</a
        >
        <a
          href="/guides/pool-water-care"
          class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-sky-300"
          >Pool Water Care</a
        >
      </div>
    </section>
  </section>
</Layout>

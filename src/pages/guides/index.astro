---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { guides } from '~/data/guides';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Guides –${SITE.name}`,
  description: 'Practical guides for pool owners — choosing a pool, setup, water care, safety, and winter storage.',
};

const categories = [...new Set(guides.map((g) => g.category))];

const catNames: Record<string, string> = {
  'buying-guide': 'Buying Guides',
  tutorial: 'Tutorials',
  safety: 'Safety',
  maintenance: 'Maintenance',
  technical: 'Technical',
  lifestyle: 'Lifestyle & Fitness',
  planning: 'Trip Planning',
};
---

<Layout metadata={metadata}>
  <meta name="ai-intent" content="pool-owner-guides,pool-setup-guide,pool-water-care" />
  <JsonLd
    type="WebSite"
    data={{
      name: 'OLagoon Guides',
      description: 'Inflatable pool guides and tutorials',
    }}
  />

  <section class="max-w-4xl mx-auto py-24 px-6" data-ai-block="definition">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Guides</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">New to Inflatable Pools?</h1>
    <p class="mt-4 text-lg text-gray-500">
      Practical guides to help you choose, set up, and enjoy your OLagoon inflatable pool.
    </p>
    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      <span class="px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium">{guides.length} guides</span>
      <span class="px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium">{categories.length} categories</span>
    </div>
  </section>

  <!-- Size Guide -->
  <section class="max-w-4xl mx-auto pb-16 px-6">
    <div class="rounded-2xl border border-sky-200 bg-sky-50 p-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">Size &amp; Specs</span>
      </div>
      <h2 class="text-2xl font-semibold text-gray-900">Find the Right Size for Your Needs</h2>
      <p class="mt-2 text-gray-500 text-sm max-w-2xl">
        Compare product dimensions, weight capacities, and recommended uses. Whether you need a family pool, a compact
        plunge pool, or a full-size swimming pool – our size guide helps you choose the right fit.
      </p>
      <div class="mt-6 grid md:grid-cols-2 gap-6">
        <div class="p-4 bg-white rounded-xl border border-sky-100">
          <h3 class="font-medium text-gray-900">Pool Dimensions</h3>
          <p class="mt-2 text-sm text-gray-600">
            Choose based on your backyard space and household. Wider pools offer more swimming room; 20 cm drop-stitch
            walls add rigidity and adult-friendly depth.
          </p>
        </div>
        <div class="p-4 bg-white rounded-xl border border-sky-100">
          <h3 class="font-medium text-gray-900">Accessories &amp; Add-ons</h3>
          <p class="mt-2 text-sm text-gray-600">
            Pumps, covers, ground mats, and entry steps complete your setup. Match accessory sizing to your pool model
            for the best fit.
          </p>
        </div>
      </div>
      <a
        href="/size-guide"
        class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-sky-700"
      >
        Full size guide with product specs →
      </a>
    </div>
  </section>

  {
    categories.map((cat) => (
      <section class="max-w-4xl mx-auto pb-16 px-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">{catNames[cat] || cat}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {guides
            .filter((g) => g.category === cat)
            .map((g) => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 text-xs mb-3">
                  <span class="px-2 py-0.5 bg-sky-50 text-sky-700 rounded-full capitalize">{g.difficulty}</span>
                  {g.waterType.slice(0, 2).map((w) => (
                    <span class="px-2 py-0.5 bg-gray-100 text-gray-500 rounded-full">{w}</span>
                  ))}
                </div>
                <h3 class="text-xl font-semibold text-gray-900">{g.title}</h3>
                <p class="mt-2 text-gray-500 text-sm">{g.description}</p>
                <a
                  href={`/guides/${g.slug}`}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-sky-700"
                >
                  Read guide →
                </a>
              </div>
            ))}
        </div>
      </section>
    ))
  }

  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      OLagoon guides cover pool selection, setup, water care, safety, maintenance, filtration, repair, winter storage,
      and site preparation for backyard pool owners.
    </p>
  </section>
</Layout>

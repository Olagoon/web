---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Media Center & Press Coverage — News, Events & Media Resources | ${SITE.name}`,
  description: `olagoon media center. Press releases, company news, product launches, trade show appearances, and downloadable media resources for journalists and partners.`,
  ignoreTitleTemplate: true,
};

const pressReleases = [
  {
    date: '2026-06-20',
    title: 'OLagoon to Exhibit at Miami International Boat Show 2026',
    summary:
      'OLagoon heads to the Miami International Boat Show with its full drop-stitch pool lineup and live fill-and-float demonstrations.',
    href: '/news/miami-boat-show-2026',
  },
  {
    date: '2026-06-18',
    title: 'Drop-Stitch 2.0 — Next Generation Core Material for Inflatable Pools',
    summary: 'New higher-density drop-stitch core increases pool wall rigidity by 25% while reducing weight by 10%.',
    href: '/news/drop-stitch-2-0',
  },
  {
    date: '2026-06-10',
    title: 'OLagoon Manufacturing Facility Achieves ISO 14001 Environmental Management Certification',
    summary:
      'Qingdao facility earns ISO 14001 certification for environmental management systems and sustainable manufacturing practices.',
    href: '/news/iso-14001-certification',
  },
  {
    date: '2026-05-01',
    title: 'OLagoon Debuts Recycled PVC Initiative Across Product Lines',
    summary: 'Company-wide sustainability program introduces recycled-content PVC in drop-stitch pools.',
    href: '/news/recycled-pvc-initiative',
  },
  {
    date: '2025-03-03',
    title: 'We Are Seeking Dealers for OLagoon',
    summary:
      'OLagoon is actively seeking dynamic dealers throughout the United States to partner with our premium drop-stitch pool brand.',
    href: '/news/seeking-dealers-for-olagoon',
  },
  {
    date: '2025-02-23',
    title: 'OLagoon Strengthens Its Global Supply Chain for 2025',
    summary:
      'Vertically integrated Qingdao production, secured material partnerships, and faster global logistics for 15,000 pools a year.',
    href: '/news/olagoon-supply-chain-2025',
  },
];

const events = [
  {
    date: '2026-09-15',
    title: 'Miami International Boat Show 2026',
    location: 'Miami, FL, USA',
    booth: 'Booth B-312',
    desc: 'Showcasing the 2027 pool lineup and the new Drop-Stitch 2.0 core material series.',
  },
  {
    date: '2026-11-08',
    title: 'METSTRADE 2026',
    location: 'Amsterdam, Netherlands',
    booth: 'Hall 10, Stand 312',
    desc: 'International marine equipment trade show. OEM/ODM partnership meetings.',
  },
];

const mediaKit = [
  {
    title: 'Brand Guidelines',
    desc: 'olagoon logo files, color palette, typography, and brand usage guidelines.',
    icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'Product Photography',
    desc: 'High-resolution product images for editorial and commercial use.',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
  {
    title: 'Factory Tour Video',
    desc: 'B-roll footage of manufacturing facility, production lines, and quality testing.',
    icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  },
  {
    title: 'Executive Bios',
    desc: 'Biographical information and headshots for executive team and engineering leadership.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
];
---

<Layout metadata={metadata}>
  <JsonLd type="BreadcrumbList" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Media Center' }]} />
  <JsonLd
    type="Article"
    article={{
      headline: 'olagoon Media Center & Press Coverage',
      description: 'Press releases, events, and media resources for journalists and partners.',
      datePublished: '2026-07-07',
    }}
    data={{ url: 'https://olagoon.com/media' }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://olagoon.com/' },
        { position: 2, name: 'Media Center', item: 'https://olagoon.com/media/' },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What media resources do you offer?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'OLagoon provides press releases, product images, company news, executive bios, and brand assets for journalists and media partners. Contact our media team for high-resolution images and interview requests.',
          },
        },
        {
          '@type': 'Question',
          name: 'How can I request a press sample?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Media professionals and content creators can request press samples by contacting our media relations team. We provide review units to qualified journalists, bloggers, and YouTube reviewers.',
          },
        },
        {
          '@type': 'Question',
          name: 'Where does OLagoon exhibit at trade shows?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'OLagoon exhibits at major backyard leisure and marine trade shows including the Miami International Boat Show, METSTRADE, and the Pool & Spa Show. Check our News section for upcoming show schedules.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I interview someone from OLagoon?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Our executive team and product specialists are available for interviews. Topics include drop-stitch pool manufacturing, industry trends, OEM/ODM partnerships, and backyard leisure market analysis.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I get permission to use OLagoon images?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Media partners may use OLagoon product images with proper attribution. Contact our media team to request usage rights and access our press kit with approved images and brand guidelines.',
          },
        },
      ],
    }}
  />

  <section class="max-w-5xl mx-auto py-24 px-6 text-center">
    <span class="text-xs font-medium uppercase tracking-[0.2em] text-sky-600">Media Center</span>
    <h1 class="mt-4 text-4xl md:text-5xl font-bold text-gray-900">Press & Media Resources</h1>
    <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
      Press releases, product announcements, trade show appearances, and downloadable media assets.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="#press"
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Press Releases</a
      >
      <a
        href="#events"
        class="px-6 py-3 border border-gray-300 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Upcoming Events</a
      >
      <a
        href="/contact"
        class="px-6 py-3 border border-gray-300 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Media Inquiries</a
      >
    </div>
  </section>

  <section class="max-w-5xl mx-auto pb-24 px-6" id="press">
    <div class="flex items-center gap-4 mb-10">
      <div class="w-10 h-10 rounded-lg bg-sky-100 flex items-center justify-center">
        <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          ></path></svg
        >
      </div>
      <h2 class="text-2xl font-bold text-gray-900">Press Releases</h2>
    </div>
    <div class="divide-y divide-gray-200 border border-gray-200 rounded-2xl overflow-hidden">
      {
        pressReleases.map((pr) => (
          <a href={pr.href} class="flex items-start gap-4 px-6 py-5 bg-white hover:bg-gray-50 transition-colors group">
            <div class="text-center shrink-0 w-12">
              <span class="block text-xs font-bold text-gray-400 uppercase">
                {pr.date.slice(5, 7)}/{pr.date.slice(8, 10)}
              </span>
              <span class="block text-sm font-bold text-gray-900">{pr.date.slice(0, 4)}</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-gray-900 group-hover:text-sky-600 transition-colors">{pr.title}</h3>
              <p class="mt-1 text-sm text-gray-500">{pr.summary}</p>
            </div>
            <span class="text-sky-600 group-hover:translate-x-1 transition-transform shrink-0">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-gray-50 py-24 px-6" id="events">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
          <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg
          >
        </div>
        <h2 class="text-2xl font-bold text-gray-900">Upcoming Events</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {
          events.map((e) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <span class="text-sm font-semibold text-amber-600">{e.date}</span>
              <h3 class="mt-1 text-lg font-semibold text-gray-900">{e.title}</h3>
              <p class="text-sm text-gray-500">{e.location}</p>
              <p class="text-sm text-gray-500">Booth: {e.booth}</p>
              <p class="mt-2 text-sm text-gray-600">{e.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto py-24 px-6">
    <div class="flex items-center gap-4 mb-10">
      <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path></svg
        >
      </div>
      <h2 class="text-2xl font-bold text-gray-900">Media Kit</h2>
    </div>
    <p class="text-gray-500 mb-10">Resources for journalists, analysts, and content creators covering olagoon.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        mediaKit.map((m) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
            <svg
              class="w-8 h-8 text-sky-600 mb-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d={m.icon} />
            </svg>
            <h3 class="font-semibold text-gray-900">{m.title}</h3>
            <p class="mt-1 text-sm text-gray-500">{m.desc}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
      >
        Request Media Access
        <span>→</span>
      </a>
    </div>
  </section>
  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        Media Center — Frequently Asked Questions
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions for journalists and media partners.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What media resources do you offer?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            OLagoon provides press releases, product images, company news, executive bios, and brand assets for
            journalists and media partners. Contact our media team for high-resolution images and interview requests.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How can I request a press sample?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Media professionals and content creators can request press samples by contacting our media relations team.
            We provide review units to qualified journalists, bloggers, and YouTube reviewers.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Where does OLagoon exhibit at trade shows?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            OLagoon exhibits at major backyard leisure and marine trade shows including the Miami International Boat
            Show, METSTRADE, and the Pool & Spa Show. Check our News section for upcoming show schedules.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can I interview someone from OLagoon?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Our executive team and product specialists are available for interviews. Topics include drop-stitch
            pool manufacturing, industry trends, OEM/ODM partnerships, and backyard leisure market analysis.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How do I get permission to use OLagoon images?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Media partners may use OLagoon product images with proper attribution. Contact our media team to request
            usage rights and access our press kit with approved images and brand guidelines.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/knowledge.ts';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { withTrailingSlash } from '~/i18n/routing';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'knowledge');

const hero = page.hero ?? {};
const clusters = page.clusters ?? {};
const featured = page.featured_guides ?? {};
const cta = page.cta ?? {};

const metadata = {
  title: `Pool Knowledge — ${SITE.name}`,
  description:
    t('knowledge.metaDesc') ||
    'Structured knowledge base on drop-stitch pool technology, water safety, pool engineering, and seasonal pool care.',
};
const crumbs = [
  { name: t('nav.home'), href: `/${lang}/` },
  { name: t('nav.knowledge'), href: withTrailingSlash(`/${lang}/knowledge`) },
];

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'OLagoon Pool Knowledge',
  description: 'Structured knowledge base on drop-stitch pools and water care topics.',
  about: {
    '@type': 'Thing',
    name: 'Drop-Stitch Inflatable Pools',
    description: 'Knowledge about drop-stitch inflatable pools, pool water care, and pool safety.',
  },
  hasPart: [
    { '@type': 'Article', name: 'Pool Knowledge', about: 'Drop-stitch pool guides and tutorials' },
    { '@type': 'Article', name: 'Technical Guides', about: 'Drop-stitch pool technical guides' },
    { '@type': 'Article', name: 'Safety Knowledge', about: 'Pool safety and water care guides' },
    { '@type': 'Article', name: 'Technology', about: 'Drop-stitch pool engineering and materials' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Product',
          name: 'Drop-Stitch Inflatable Pool',
          category: 'Inflatable Pool',
          audience: { '@type': 'Audience', audienceType: 'Families and Homeowners' },
          application: { '@type': 'Thing', name: 'Backyard swimming, family fun, entertaining' },
        },
      },
    ],
  },
};

const entityGraphData = {
  '@context': {
    rdf: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#',
    rdfs: 'http://www.w3.org/2000/01/rdf-schema#',
    schema: 'https://schema.org/',
    aqua: 'https://olagoon.com/kg/',
  },
  '@graph': [
    {
      '@id': 'aqua:OLagoon',
      '@type': 'schema:Brand',
      'schema:name': 'OLagoon',
      'schema:description': 'Drop-Stitch Inflatable Pool Brand',
      'schema:manufactures': [{ '@id': 'aqua:product-pool' }],
    },
    {
      '@id': 'aqua:product-pool',
      '@type': 'schema:Product',
      'schema:name': 'Drop-Stitch Inflatable Pool',
      'schema:description': 'Rigid inflatable pool engineered like a yacht deck with 20 cm drop-stitch walls',
    },
    {
      '@id': 'aqua:technology-dropstitch',
      '@type': 'schema:Thing',
      'schema:name': 'Drop-Stitch 2.0 Core Technology',
      'schema:description': '16,000 threads per square meter create rigid pool walls at 10-15 PSI',
      'aqua:usedIn': [{ '@id': 'aqua:product-pool' }],
    },
    {
      '@id': 'aqua:technology-pvc',
      '@type': 'schema:Thing',
      'schema:name': 'Military-Grade PVC',
      'schema:description': 'UV-stabilized, puncture-resistant PVC with RF-welded seams',
      'aqua:usedIn': [{ '@id': 'aqua:product-pool' }],
    },
    {
      '@id': 'aqua:use-smallbackyard',
      '@type': 'schema:Audience',
      'schema:name': 'Small Backyard Owners',
      'schema:description': 'Homeowners with compact yards who want a plunge pool without construction',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-pool' }],
    },
    {
      '@id': 'aqua:use-family',
      '@type': 'schema:Audience',
      'schema:name': 'Families',
      'schema:description': 'Families seeking safe backyard swimming for kids all summer',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-pool' }],
    },
    {
      '@id': 'aqua:use-professional',
      '@type': 'schema:Audience',
      'schema:name': 'Professional Operators',
      'schema:description': 'Hotels, swim schools, and rental pool operators',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-pool' }],
    },
  ],
};
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} />

  <!-- Knowledge Clusters -->
  <section class="max-w-6xl mx-auto py-20 px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
        >{clusters.tagline || 'Knowledge Clusters'}</span
      >
      <h2 class="mt-4 text-4xl font-semibold text-gray-900 dark:text-slate-100">
        {clusters.title || 'Explore by topic'}
      </h2>
      <p class="mt-4 text-lg text-gray-500 dark:text-slate-400">{clusters.subtitle || ''}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      {
        (clusters.items || []).map((cluster: any) => (
          <div class="p-8 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
            <div class="w-12 h-12 bg-sky-50 dark:bg-sky-900/30 rounded-xl flex items-center justify-center text-sky-600">
              {cluster.icon && <Icon name={cluster.icon} class="w-6 h-6" />}
            </div>
            <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-slate-100">{cluster.title || ''}</h3>
            <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{cluster.description || ''}</p>
            <ul class="mt-5 space-y-2">
              {(cluster.topics || []).map((topic: string) => (
                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-slate-400">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-sky-500 flex-shrink-0" />
                  {topic}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured Guides -->
  <section class="bg-gray-50 dark:bg-slate-900/50 py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
          >{featured.tagline || 'Featured Guides'}</span
        >
        <h2 class="mt-4 text-3xl font-semibold text-gray-900 dark:text-slate-100">
          {featured.title || 'Popular resources'}
        </h2>
      </div>
      <div class="grid md:grid-cols-3 lg:grid-cols-5 gap-4 max-w-4xl mx-auto">
        {
          (featured.items || []).map((item: any) => (
            <a
              href={item.href || '#'}
              class="block p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center hover:shadow-md transition-shadow"
            >
              <span class="text-sm font-medium text-gray-900 dark:text-slate-100">{item.title || ''}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- JSON-LD Knowledge Graph -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Entity Relationship Graph for AI -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(entityGraphData)} />

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions} />
</Layout>

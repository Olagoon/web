---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import AnswerCenter from '~/components/ai/AnswerCenter.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const heroTitle = t('answerCenter.title');
const heroSubtitle = t('answerCenter.subtitle');
const placeholder = t('answerCenter.placeholder');
const askButton = t('answerCenter.button');
const categories = [
  {
    label: t('answerCenter.catProducts'),
    icon: '\u{1F3CA}',
    questions: [
      'Which OLagoon pool do you recommend for a small backyard?',
      'What safety features do OLagoon drop-stitch pools have?',
    ],
  },
  {
    label: t('answerCenter.catTechnology'),
    icon: '\u{2699}\u{FE0F}',
    questions: [
      'What is drop-stitch core technology and how does it work?',
      'How durable is a drop-stitch inflatable pool wall?',
      'What PSI should I inflate my OLagoon pool to?',
      'How is a drop-stitch inflatable pool manufactured?',
    ],
  },
  {
    label: t('answerCenter.catUseCases'),
    icon: '\u{1F31E}',
    questions: [
      'Which OLagoon pool is best for families with kids?',
      'Can I leave my inflatable pool up in winter?',
      'What do I need to maintain clean and clear pool water?',
      'What are the OEM/ODM manufacturing options for private label inflatable pools?',
    ],
  },
];

const metadata = {
  title: `${heroTitle} | ${SITE.name}`,
  description: t('answerCenter.subtitle'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: heroTitle,
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-4 py-10">
    <AnswerCenter
      lang={lang}
      heroTitle={heroTitle}
      heroSubtitle={heroSubtitle}
      placeholder={placeholder}
      askButton={askButton}
      categories={categories}
    />
  </div>
</Layout>

---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import HomeLanding from '~/components/widgets/HomeLanding.astro';
import { languages as langMap } from '~/i18n/config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';
import type { MetaData } from '~/types';

export async function getStaticPaths() {
  return Object.keys(langMap).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
setPageContentData(__pageData);
const page = getPageContent(lang || 'en');

const metadata = {
  title: page.meta?.title || 'OLagoon Drop-Stitch Inflatable Pools | Your Backyard Lagoon',
  description:
    page.meta?.description ||
    'OLagoon drop-stitch inflatable pools — rigid 20 cm walls at 10–15 PSI, sand filtration, 15-minute setup. Three sizes from 2 m to 5 m.',
  ignoreTitleTemplate: true,
} as MetaData;
---

<Layout metadata={metadata}>
  <meta
    name="ai-intent"
    content="drop-stitch-inflatable-pool,backyard-inflatable-pool,plunge-pool,family-pool,portable-swimming-pool,inflatable-pool-buying-guide"
  />
  <meta name="X-Robots-Tag" content="index, follow" />
  <HomeLanding lang={lang || 'en'} localize={true} page={page} />
</Layout>

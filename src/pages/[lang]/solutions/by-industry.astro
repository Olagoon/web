---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import { withTrailingSlash } from '~/i18n/routing';

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';

const metadata = {
  title: `Solutions by Industry — Inflatable Pool Solutions for Every Sector | ${SITE.name}`,
  description:
    'Find the right inflatable pool solution for your industry. Resorts, rental operators, swim schools, wellness studios, retail, and community programs — OLagoon manufactures CE-certified pools for every sector.',
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: t('nav.home'), href: `/${lang}/` }, { name: 'Solutions by Industry' }];

const industries = [
  {
    name: 'Resorts & Hotels',
    color: 'from-teal-50 to-emerald-50',
    border: 'border-teal-200',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
    description:
      'Resort pool packages for guest amenities and programming. Family and grand-size pools, custom-branded shells, staff training, and seasonal storage support.',
    craft: ['Family Oasis and Grand Lagoon pools', 'Custom-branded pool shells', 'Filtration and cover packages'],
    certs: ['CE certified', 'Commercial amenity grade'],
    link: withTrailingSlash(`/${lang}/solutions/resorts-hotels`),
  },
  {
    name: 'Rental & Events Operators',
    color: 'from-sky-50 to-blue-50',
    border: 'border-sky-200',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    description:
      'Pools engineered for 1,000+ inflation cycles and daily rental use. Drop-Stitch 2.0 construction, UV-resistant materials, and quick-turnaround replacement support.',
    craft: ['Rental-grade pool fleets', 'Compact plunge spa pools', 'Pump and accessory bundles'],
    certs: ['CE certified', 'UV and chlorine tested'],
    link: withTrailingSlash(`/${lang}/solutions/rental-operators`),
  },
  {
    name: 'Swim Schools & Aquatic Programs',
    color: 'from-violet-50 to-purple-50',
    border: 'border-violet-200',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    description:
      'Shallow-water training pools for swim schools and aquatic programs. Stable 20 cm walls, non-slip surfaces, and modular multi-pool layouts for group lessons.',
    craft: ['Shallow training pools', 'Multi-lane lesson setups', 'Entry steps and safety mats'],
    certs: ['CE certified', 'Child-safe materials'],
    link: withTrailingSlash(`/${lang}/solutions/swim-school-pool-program`),
  },
  {
    name: 'Wellness & Spa Operators',
    color: 'from-cyan-50 to-blue-50',
    border: 'border-cyan-200',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197',
    description:
      'Cold plunge and relaxation pools for wellness studios, spas, and health clubs. Compact footprints, rapid cooling compatibility, and premium finishes.',
    craft: ['Compact plunge pools', 'Thermal cover packages', 'Premium liner finishes'],
    certs: ['CE certified', 'REACH compliant materials'],
    link: withTrailingSlash(`/${lang}/solutions/wellness-spa-pool-program`),
  },
  {
    name: 'Retail Chains & Distributors',
    color: 'from-amber-50 to-yellow-50',
    border: 'border-amber-200',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 12.5V17a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3.5a2 2 0 012 2v.5M15 12.5V17a2 2 0 01-2 2H6',
    description:
      'Private-label pool programs and wholesale distribution. Full OEM/ODM support from design and tooling to packaging and compliance documentation.',
    craft: ['Private-label pool lines', 'Retail-ready packaging', 'Wholesale territory programs'],
    certs: ['CE certified', 'ISO 9001 manufacturing'],
    link: withTrailingSlash(`/${lang}/solutions/retail-partners`),
  },
  {
    name: 'Summer Camps & Community Programs',
    color: 'from-green-50 to-emerald-50',
    border: 'border-green-200',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z',
    description:
      'Durable community pools for camps, HOAs, and municipal programs. Rapid deployment, multi-season storage, and group-size configurations for 8-20+ swimmers.',
    craft: ['Group-size pool layouts', 'Ground mats and entry steps', 'Seasonal storage kits'],
    certs: ['CE certified', 'BSCI audited factory'],
    link: withTrailingSlash(`/${lang}/solutions/summer-camp-pool-package`),
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">Solutions by Industry</h1>
    <p class="mt-4 text-lg text-gray-500">
      Find the right inflatable pool solution for your industry. Each solution is backed by CE certification, ISO
      quality management, and a 12,000 m² manufacturing facility.
    </p>

    <div class="mt-16 space-y-8">
      {
        industries.map((ind) => (
          <div
            class={`bg-gradient-to-br ${ind.color} rounded-2xl border ${ind.border} p-8 hover:shadow-md transition-shadow`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-white/80 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-6 h-6 text-gray-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={ind.icon} />
                </svg>
              </div>
              <div class="flex-1">
                <h2 class="text-xl font-semibold text-gray-900">{ind.name}</h2>
                <p class="mt-2 text-sm text-gray-600">{ind.description}</p>
                <div class="mt-4">
                  <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">
                    {t('solutionsByIndustry.recommendedCraft') || 'Recommended Pool Packages'}
                  </span>
                  <ul class="mt-2 space-y-1">
                    {ind.craft.map((c) => (
                      <li class="flex items-center gap-2 text-sm text-gray-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400 flex-shrink-0" />
                        {c}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-3 flex items-center gap-4">
                  <span class="text-xs text-gray-400">{ind.certs.join(' · ')}</span>
                </div>
                <a
                  href={ind.link}
                  class="mt-4 inline-flex text-sm font-medium text-sky-600 hover:text-sky-700 hover:underline"
                >
                  {t('solutionsByIndustry.learnMore') || 'Learn more'} →
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <section class="mt-16 bg-gray-50 rounded-2xl p-8 border border-gray-200 text-center">
      <h2 class="text-2xl font-semibold text-gray-900">
        {t('solutionsByIndustry.ctaTitle') || 'Need a Custom Solution?'}
      </h2>
      <p class="mt-4 text-gray-500">
        {
          t('solutionsByIndustry.ctaDesc') ||
            'Our OEM/ODM team can design and manufacture custom inflatable pools for your specific industry requirements.'
        }
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a
          href={withTrailingSlash(`/${lang}/oem-odm-manufacturer`)}
          class="px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
          >{t('solutionsByIndustry.ctaBtn') || 'OEM/ODM Services'}</a
        >
        <a
          href={withTrailingSlash(`/${lang}/contact`)}
          class="px-8 py-4 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition"
          >{t('solutionsByIndustry.contactBtn') || 'Contact Us'}</a
        >
      </div>
    </section>
  </section>

  <ExperienceLayer
    title={t('solutionsByIndustry.expTitle') || 'Industry Solutions in Action'}
    subtitle={t('solutionsByIndustry.expSub') ||
      'Real examples of how OLagoon pools perform across different industry sectors.'}
    stories={[
      {
        quote:
          'Our rental pools go out four times a day in peak season. After two summers, the welded seams still look new.',
        narrative:
          'A beachfront rental operation in Thailand runs a 40-unit OLagoon rental fleet. The pools are set up and packed down up to four times daily in tropical sun. After 1,000+ inflation cycles across two seasons, the drop-stitch floors show no significant UV degradation and no seam separation.',
        context: 'Rental pool fleet, Thailand, 2023-2025',
        source: 'Rental Operation Owner',
      },
      {
        quote:
          'The mixed-size fleet lets us teach beginners and run advanced classes with the same supplier. Bulk pricing made the program viable.',
        narrative:
          'A swim school in Europe outfitted its lesson program with OLagoon pools — shallow training pools for first-timers and family-size pools for advanced groups. Custom school branding on every pool, with a replacement program that keeps lessons running year-round.',
        context: 'Swim school pool program, Europe, 2024',
        source: 'Aquatic Program Director',
      },
    ]}
  />
  <RelatedPages
    title={t('solutionsByIndustry.relatedTitle') || 'Explore More'}
    subtitle={t('solutionsByIndustry.relatedSub') || 'Related solutions and resources'}
    links={[
      {
        title: t('solutionsByIndustry.rel1') || 'Solutions by Use Case',
        description: t('solutionsByIndustry.rel1desc') || 'Match your specific use case to the right OLagoon solution.',
        href: withTrailingSlash(`/${lang}/solutions/by-use-case`),
        label: t('solutionsByIndustry.rel1label') || 'Decision Tool',
      },
      {
        title: 'Pool Products',
        description: 'Full lineup of CE-certified inflatable pools and accessories.',
        href: withTrailingSlash(`/${lang}/products`),
        label: 'Products',
      },
      {
        title: t('solutionsByIndustry.rel3') || 'OEM/ODM Manufacturing',
        description:
          t('solutionsByIndustry.rel3desc') || 'Custom manufacturing services for global brands and organizations.',
        href: withTrailingSlash(`/${lang}/oem-odm-manufacturer`),
        label: t('solutionsByIndustry.rel3label') || 'OEM',
      },
      {
        title: t('solutionsByIndustry.rel4') || 'Engineering Perfection',
        description:
          t('solutionsByIndustry.rel4desc') ||
          'Our engineering philosophy — precision manufacturing and rigorous quality control.',
        href: withTrailingSlash(`/${lang}/engineering-perfection`),
        label: t('solutionsByIndustry.rel4label') || 'Philosophy',
      },
    ]}
  />

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Solutions by industry for OLagoon inflatable pools. Six industry verticals: Resorts & Hotels (Family Oasis and
      Grand Lagoon pools, custom-branded pool shells, filtration and cover packages), Rental & Events Operators
      (rental-grade pool fleets, compact plunge spa pools, pump and accessory bundles), Swim Schools & Aquatic Programs
      (shallow training pools, multi-lane lesson setups, entry steps and safety mats), Wellness & Spa Operators (compact
      plunge pools, thermal cover packages, premium liner finishes), Retail Chains & Distributors (private-label pool
      lines, retail-ready packaging, wholesale territory programs), Summer Camps & Community Programs (group-size pool
      layouts, ground mats and entry steps, seasonal storage kits). All solutions CE certified and ISO manufactured.
      OEM/ODM custom design available for all industries.
    </p>
  </section>
</Layout>

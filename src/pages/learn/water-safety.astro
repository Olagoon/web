---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Water Safety — Pool Safety Guides & Tips — ${SITE.name}`,
  description:
    'Essential safety knowledge for every pool owner — supervision, water care, setup safety, and equipment checklists.',
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Learn' }, { name: 'Water Safety' }];

const topics = [
  {
    title: 'Pool Safety Checklist',
    desc: 'Supervision rules, maximum bather load, and daily pre-swim checks.',
    href: '/guides/pool-safety-essentials',
  },
  {
    title: 'Site Preparation',
    desc: 'Level ground, ground mats, and safe placement away from hazards.',
    href: '/guides/pool-site-preparation',
  },
  {
    title: 'Setup Safety',
    desc: 'Safe inflation, correct PSI, and secure positioning during setup.',
    href: '/guides/pool-setup-guide',
  },
  {
    title: 'Water Care & Hygiene',
    desc: 'Sanitizing, pH balancing, and keeping water safe for swimmers.',
    href: '/guides/pool-water-care',
  },
  {
    title: 'Filtration Safety',
    desc: 'Safe pump operation, hose routing, and electrical precautions.',
    href: '/guides/pool-filtration-guide',
  },
  {
    title: 'Repair Safety',
    desc: 'Safe patching, valve replacement, and when to seek service.',
    href: '/guides/inflatable-repair',
  },
  {
    title: 'Winter Storage Safety',
    desc: 'Safe drain-down, pack-up, and off-season inspection.',
    href: '/guides/pool-winter-storage',
  },
  {
    title: 'Safety Equipment',
    desc: 'Essential safety gear — entry steps, ground mats, covers, and first aid kits.',
    href: '/safety',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd
    type="Article"
    article={{
      headline: metadata.title,
      description: metadata.description,
      datePublished: '2024-10-15',
      dateModified: '2025-05-30',
    }}
  />
  <section class="px-6 py-16 max-w-5xl mx-auto text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wider">Water Safety</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">Pool Safety Guides</h1>
    <p class="mt-3 text-lg text-muted max-w-2xl mx-auto">
      Essential safety knowledge for every pool owner — from setup to water care.
    </p>
  </section>

  <section class="px-6 pb-20 max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        topics.map((t) => (
          <a
            href={t.href}
            class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
          >
            <h3 class="font-semibold text-gray-900 group-hover:text-sky-600 transition-colors">{t.title}</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">{t.desc}</p>
            <span class="mt-4 inline-flex text-sm font-medium text-sky-600 group-hover:text-sky-700">Read guide →</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

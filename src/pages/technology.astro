---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/technology.ts';
import JsonLd from '~/components/common/JsonLd.astro';

const lang = Astro.locals.lang;

setPageContentData(__pageData);
const page = getPageContent(lang, 'technology') || {};
const hero = page.hero || {};
const sections = page.sections || [];
const related = page.related || {};

const metadata = {
  title: `Drop-Stitch Pool Technology & PVC Construction | ${SITE.name}`,
  description:
    'OLagoon drop-stitch pool technology: 16,000 threads/m² core, marine-grade PVC lamination, fusion welding, and 20 cm rigid wall systems. Built by a professional inflatable pool manufacturer.',
};
---

<JsonLd
  type="BreadcrumbList"
  data={{
    itemListElement: [
      { position: 1, name: 'Home', item: 'https://olagoon.com/' },
      { position: 2, name: 'Technology', item: 'https://olagoon.com/technology/' },
    ],
  }}
/>
<JsonLd
  type="FAQPage"
  data={{
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is drop-stitch core technology?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Drop-stitch core uses thousands of internal polyester threads connecting the top and bottom layers of an inflatable pool wall, creating a rigid structure at 10-15 PSI that rivals rigid pool construction.',
        },
      },
      {
        '@type': 'Question',
        name: 'What materials does OLagoon use for inflatable pools?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'OLagoon uses multi-layer laminated marine-grade PVC with fusion-welded seams, delivering UV resistance, chlorine resistance, and long-term performance.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does fusion welding differ from gluing?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Fusion welding bonds layers at a molecular level using heat and pressure, eliminating the delamination risks associated with adhesive bonding. This results in stronger, longer-lasting seams.',
        },
      },
      {
        '@type': 'Question',
        name: 'How rigid are the 20 cm pool walls?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The drop-stitch walls inflate to 10-15 PSI and stay ruler-straight — rigid enough to sit on the edge. Drop-Stitch 2.0 adds 16,000 threads per square meter for +25% more rigidity.',
        },
      },
    ],
  }}
/>

<Layout metadata={metadata}>
  <meta
    name="ai-intent"
    content="drop-stitch-pool-technology,inflatable-pool-construction,pvc-lamination,fusion-welding,pool-wall-rigidity"
  />

  <section class="max-w-4xl mx-auto py-24 px-6" data-ai-block="definition">
    <span class="text-sm font-medium text-primary tracking-wide uppercase">{hero.tagline || 'Technology'}</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{hero.title || 'Built for Performance'}</h1>
    <p class="mt-4 text-lg text-gray-500">
      {
        hero.subtitle ||
          'Every OLagoon pool is engineered with precision materials and construction methods tested for years of backyard use.'
      }
    </p>
  </section>

  <section class="max-w-4xl mx-auto pb-24 px-6">
    <div class="space-y-12">
      {
        (sections.length > 0
          ? sections
          : [
              {
                title: 'Drop-Stitch Core',
                description:
                  'Thousands of internal polyester threads connect the top and bottom layers, creating a rigid structure at 10-15 PSI. This is the same technology used in yacht tenders and high-performance inflatables.',
                image: 'https://assets.olagoon.com/images/olagoon/tech/tech-drop-stitch.webp',
              },
              {
                title: 'Marine-Grade PVC',
                description:
                  'Multi-layer laminated PVC fabric rated for outdoor environments. Each layer is fusion-welded rather than glued, eliminating delamination risks. Tested for UV resistance, chlorine exposure, and abrasion.',
                image: 'https://assets.olagoon.com/images/olagoon/tech/tech-pvc-material.webp',
              },
              {
                title: 'Rigid 20 cm Walls',
                description:
                  'High-pressure drop-stitch walls replace steel frames or rigid panels. Setup takes minutes with an electric pump, and the pool stores in a compact carry bag for winter.',
                image: 'https://assets.olagoon.com/images/olagoon/tech/tech-air-deck.webp',
              },
            ]
        ).map((sec: any, i: number) => {
          const isReversed = i % 2 === 1;
          return (
            <div class="grid md:grid-cols-2 gap-8 items-center">
              {isReversed ? (
                <>
                  <div class="order-2 md:order-1 rounded-2xl h-48 overflow-hidden">
                    <img src={sec.image} alt={sec.title} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                  <div class="order-1 md:order-2">
                    <h2 class="text-2xl font-semibold text-gray-900">{sec.title}</h2>
                    <p class="mt-3 text-gray-600">{sec.description}</p>
                  </div>
                </>
              ) : (
                <>
                  <div>
                    <h2 class="text-2xl font-semibold text-gray-900">{sec.title}</h2>
                    <p class="mt-3 text-gray-600">{sec.description}</p>
                  </div>
                  <div class="rounded-2xl h-48 overflow-hidden">
                    <img src={sec.image} alt={sec.title} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                </>
              )}
            </div>
          );
        })
      }
    </div>

    <!-- FAQ Section -->
    <section class="mt-16">
      <div class="text-center mb-10">
        <span class="text-sm font-medium text-primary tracking-wide uppercase">FAQs</span>
        <h2 class="mt-2 text-3xl font-semibold text-gray-900">Technology Questions Explained</h2>
        <p class="mt-3 text-gray-500">Common questions about our materials and construction methods.</p>
      </div>
      <div class="space-y-4">
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What is drop-stitch core technology?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Drop-stitch core uses thousands of internal polyester threads connecting the top and bottom layers of an
              inflatable pool wall, creating a rigid structure at 10-15 PSI that rivals rigid pool construction.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What materials does OLagoon use for inflatable pools?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              OLagoon uses multi-layer laminated marine-grade PVC with fusion-welded seams, delivering UV resistance,
              chlorine resistance, and long-term performance.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>How does fusion welding differ from gluing?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Fusion welding bonds layers at a molecular level using heat and pressure, eliminating the delamination
              risks associated with adhesive bonding. This results in stronger, longer-lasting seams.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>How rigid are the 20 cm pool walls?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              The drop-stitch walls inflate to 10-15 PSI and stay ruler-straight — rigid enough to sit on the edge.
              Drop-Stitch 2.0 adds 16,000 threads per square meter for +25% more rigidity.
            </p>
          </div>
        </details>
      </div>
    </section>

    <section class="mt-12 p-6 bg-gray-50 rounded-2xl border border-gray-200">
      <h2 class="font-semibold text-gray-900">{related.title || 'Related'}</h2>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        {
          (related.links && related.links.length > 0
            ? related.links
            : [
                { text: 'R&D Center', url: '/randdcenter' },
                { text: 'Safety Standards', url: '/safety' },
                { text: 'Guides', url: '/guides' },
                { text: 'Products', url: '/products' },
              ]
          ).map((link: any) => (
            <a
              href={link.url}
              class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-primary"
            >
              {link.text}
            </a>
          ))
        }
      </div>
    </section>
  </section>

  <section class="sr-only" data-ai-block="embedding-anchor" aria-hidden="true">
    <p>
      OLagoon technology focuses on drop-stitch core rigidity, fusion-welded PVC lamination, structural wall stability,
      and long-term UV and chlorine resistance for premium backyard inflatable pools.
    </p>
  </section>
</Layout>

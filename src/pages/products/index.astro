---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import QuickViewModal from '~/components/widgets/QuickViewModal.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Icon from '~/components/ui/Icon.astro';

import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  getProductSeries,
  isProductsEnabled,
  isProductsListEnabled,
  productSeriesLabels,
} from '~/utils/products';
import { PRODUCT_LIST, getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';

const products = await getProducts();
const categories = await getProductCategories();
const seriesArr = await getProductSeries();
const rawCategory = (Astro.url?.searchParams?.get('category') ?? '') as 'accessory' | 'pool' | '';
const activeCategory = rawCategory === 'accessory' || rawCategory === 'pool' ? rawCategory : null;
const rawSeries = (Astro.url?.searchParams?.get('series') ?? '') as 'plunge' | 'family' | 'grand' | '';
const activeSeries = seriesArr.some((s) => s.slug === rawSeries) ? rawSeries : null;
const filteredByCategory = activeCategory ? products.filter((p) => p.category === activeCategory) : products;
const filteredProducts = activeSeries
  ? filteredByCategory.filter((p) => p.series === activeSeries)
  : filteredByCategory;
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();

const activeSeriesTitle = activeSeries && productSeriesLabels[activeSeries];

const metadata = merge(
  {
    title: activeSeriesTitle
      ? `${activeSeriesTitle} Inflatable Pools | ${SITE.name}`
      : `Inflatable Pool Products | ${SITE.name}`,
    description: activeSeriesTitle
      ? `Browse the ${activeSeriesTitle} collection of inflatable drop-stitch pools from ${SITE.name} – factory-direct construction with OEM/ODM manufacturing for pool and resort partners.`
      : `Browse the full ${SITE.name} product catalog — drop-stitch inflatable pools and pool accessories. Country distribution and co-branding available for qualified partners.`,
    canonical: getCanonical(getPermalink(PRODUCT_LIST)),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://olagoon.com/' },
        { position: 2, name: 'Products', item: 'https://olagoon.com/products/' },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What products does olagoon manufacture?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'OLagoon manufactures drop-stitch inflatable pools (compact plunge, family, and grand sizes), pool accessories (filter pumps, covers, ground mats, entry steps), and OEM/ODM custom pools.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I get custom manufacturing for my product needs?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. We offer OEM/ODM services including custom design, private label, bulk wholesale, and contract manufacturing for all our product categories.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are olagoon products available for bulk orders?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Factory-direct and wholesale pricing is available for bulk orders. Contact our B2B team for quantity-based pricing and lead times.',
          },
        },
        {
          '@type': 'Question',
          name: 'What certifications do olagoon products carry?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All olagoon products are CE certified. Our pools comply with the EN ISO 25649 family of standards where applicable. Our factory is ISO 9001 and BSCI certified.',
          },
        },
      ],
    }}
  />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Catalog</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">olagoon products</h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Premium drop-stitch inflatable pools, accessories and engineered products — built for life on the water.
      </p>
    </header>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-6">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href={getPermalink(PRODUCT_LIST)}
              class:list={[
                'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                !activeCategory
                  ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                  : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
              ]}
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All ({totalCount})
            </a>
            {categories.map((c) => (
              <a
                href={`${getPermalink(PRODUCT_LIST)}?category=${encodeURIComponent(c.slug)}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  activeCategory === c.slug && !activeSeries
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {c.title} ({c.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      seriesArr.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href={getPermalink(PRODUCT_LIST)}
              class:list={[
                'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                !activeSeries
                  ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                  : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
              ]}
            >
              <Icon name="tabler:layers-intersect" class="w-4 h-4" />
              All series
            </a>
            {seriesArr.map((s) => (
              <a
                href={`${getPermalink(PRODUCT_LIST)}?series=${encodeURIComponent(s.slug)}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  activeSeries === s.slug
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {s.title} ({s.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      filteredProducts.length === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a
            class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block"
            href={getPermalink(PRODUCT_LIST)}
          >
            View all products
          </a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {filteredProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      )
    }
  </section>

  {filteredProducts.map((p) => <QuickViewModal productId={p.slug} />)}

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      olagoon product catalog: drop-stitch inflatable pools (compact plunge, family oasis, grand lagoon), pool
      accessories (sand filter pumps, thermal covers, ground mats, entry steps), OEM/ODM services (custom design,
      private label, contract manufacturing). All products CE certified, compliant. Factory-direct and wholesale pricing
      available.
    </p>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto pb-20 px-6">
    <div class="text-center mb-10">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">FAQs</span>
      <h2 class="mt-2 text-3xl font-bold text-gray-900">Product FAQ</h2>
      <p class="mt-3 text-gray-500">Common questions about our product range and manufacturing.</p>
    </div>
    <div class="space-y-4">
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What products does olagoon manufacture?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            OLagoon manufactures drop-stitch inflatable pools (compact plunge, family, and grand sizes), pool
            accessories (filter pumps, covers, ground mats, entry steps), and OEM/ODM custom pools.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Can I get custom manufacturing for my product needs?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. We offer OEM/ODM services including custom design, private label, bulk wholesale, and contract
            manufacturing for all our product categories.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Are olagoon products available for bulk orders?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. Factory-direct and wholesale pricing is available for bulk orders. Contact our B2B team for
            quantity-based pricing and lead times.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What certifications do olagoon products carry?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            All olagoon products are CE certified. Our pools comply with the EN ISO 25649 family of standards where
            applicable. Our factory is ISO 9001 and BSCI certified.
          </p>
        </div>
      </details>
    </div>
  </section>
</Layout>

---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import useCasesData from '~/data/site/use-cases.yaml';

interface UseCaseEntry {
  id: string;
  title: string;
  desc: string;
  image: string;
}

const d = useCasesData as any;
const useCases: UseCaseEntry[] = (d.cases ?? []).map((c: any) => ({
  id: c.id,
  title: c.title,
  desc: c.desc,
  image: c.image,
}));

const useCaseFaqs = [
  {
    q: 'How long does an OLagoon pool take to set up?',
    a: 'Unbox, lay the Ground Mat, roll out the pool, and inflate with the included pump — most setups take 15-25 minutes with no tools and no construction.',
  },
  {
    q: 'Do I need a perfectly flat surface?',
    a: 'A level surface gives the best water line and stability. Lawns, patios, and decks all work — put the Ground Mat down first to protect the base.',
  },
  {
    q: 'How do I keep the water clean all summer?',
    a: 'Run the Sand Filter Pump daily and keep the Thermal Pool Cover on between swims. It blocks debris, holds heat, and keeps water swim-ready.',
  },
  {
    q: 'Can I leave the pool up all summer?',
    a: 'Yes. The UV-stabilized military-grade PVC walls are built for full-season sun. At the end of the season, drain, deflate, and store the pool flat.',
  },
];

const metadata = {
  title: `Use Cases & Applications | ${SITE.name}`,
  description: `Explore OLagoon drop-stitch inflatable pools for small backyards, family fun, garden entertaining, and hosting.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://olagoon.com/' },
        { position: 2, name: 'Use Cases', item: 'https://olagoon.com/use-cases/' },
      ],
    }}
  />
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Use Cases & Applications',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: useCaseFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Use Cases</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Use Cases</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">Applications & Use Cases</h1>
      <p class="mt-4 text-lg text-gray-500">
        From plunge pools for compact yards to statement lagoons for hosting — find the right OLagoon pool for how you
        play.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        useCases.map((uc) => (
          <a
            href={`/use-cases/${uc.id}`}
            class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
          >
            <div class="h-44 bg-gray-100 overflow-hidden">
              <img
                src={uc.image}
                alt={uc.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                {uc.title}
              </h2>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{uc.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                View use case &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- FAQ Section -->
    <section class="mt-20">
      <div class="text-center mb-10">
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">FAQs</span>
        <h2 class="mt-4 text-3xl font-bold text-gray-900">Use Case FAQ</h2>
        <p class="mt-3 text-gray-500">Common questions about choosing an OLagoon pool.</p>
      </div>
      <div class="space-y-4 max-w-3xl mx-auto">
        {
          useCaseFaqs.map((f) => (
            <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
              <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
                <span>{f.q}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
              </summary>
              <div class="px-6 pb-4">
                <p class="text-gray-600 leading-relaxed">{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
